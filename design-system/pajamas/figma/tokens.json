  "shadow": {
    "sm": "0px 1px 4px 0px #05050629, 0px 0px 2px 0px #05050629",
    "md": "0px 2px 8px 0px #05050629, 0px 0px 2px 0px #05050629, 0px 0px 1px 0px #05050629",
    "lg": "0px 4px 12px 0px #05050629, 0px 0px 2px 0px #05050629, 0px 0px 2px 0px #05050629"
