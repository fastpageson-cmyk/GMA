        "size": 36,
        "lineHeight": "112.5%",
        "weight": "SemiBold"
      },
      "Display ≤md": {
        "size": 28,
        "lineHeight": "112.5%",
        "weight": "SemiBold"
      },
      "h1 ≥xl": {
        "size": 30,
