      },
      "h1 ≤md": {
        "size": 24,
        "lineHeight": "125%",
        "weight": "SemiBold"
      },
      "h2 ≥xl": {
        "size": 25,
        "lineHeight": "125%",
        "weight": "SemiBold"
      },
      "h2 ≤md": {
        "size": 21,
        "lineHeight": "125%",
        "weight": "SemiBold"
      },
      "h3 ≥xl": {
